# Fish Audio API key: https://fish.audio/app/api-keys
# The voice renders use it, and they bill prepaid API credit (add a few dollars at
# https://fish.audio/app/developers/billing/). Paste the key here, never in chat.
FISH_API_KEY=

# Your cloned voice. scripts/clone_voice.py fills these in during voice setup.
# The pitch is your normal speaking pitch, used to spot renders that drift away from sounding like you.
FISH_VOICE_ID=
FISH_VOICE_PITCH_HZ=

# A Fish Audio library voice for speaker 1 in dialogue scenes, and its normal pitch.
FISH_CLAUDE_VOICE_ID=
FISH_CLAUDE_VOICE_PITCH_HZ=

# One clear, front-facing photo of you (JPEG/PNG/WebP, under 20 MB).
FISH_PHOTO=me/photo.jpg

# Claude fills this in after the first upload so your photo isn't re-uploaded every time.
FISH_PHOTO_KEY=

# Lower sticks closer to your real voice (Drama 3 default is 0.7). 0.3 matched best in testing.
FISH_TEMPERATURE=0.3

# Render quieter at the source so Fish Audio never hits its limiter (that crunchy, clipped sound).
FISH_VOLUME_DB=-6
